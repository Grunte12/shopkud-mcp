# Documentation placeholders only. ShopKud does not automatically load dotenv.
# The setup command creates the private config and bearer key outside this repo.
SHOPKUD_EXTENSION_ID=<extension-id>
SHOPKUD_STATE_DIR=<absolute-private-state-directory>
SHOPKUD_NATIVE_MANIFEST_DIR=<absolute-native-messaging-manifest-directory>
SHOPKUD_MCP_CONFIG=<absolute-private-config-path>
# Optional offline-test runtime overrides; never use a personal browser profile.
SHOPKUD_TEST_PYTHON=<absolute-development-python-path>
SHOPEE_TEST_CHROMIUM=<absolute-isolated-chromium-executable-path>
